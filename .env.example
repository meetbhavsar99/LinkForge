# PostgreSQL connection string used by Prisma.
# For local dev with the bundled docker-compose, the defaults work as-is.
DATABASE_URL="postgresql://linkforge:linkforge@localhost:5432/linkforge?schema=public"

# Port the Express server listens on. Defaults to 4000 if unset.
PORT=4000

# Set to "production" in deployed environments to disable verbose query logging.
NODE_ENV=development